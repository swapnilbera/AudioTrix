        "# Import libraries\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from skimage import io, color, transform\n",
        "from skimage.metrics import peak_signal_noise_ratio as compare_psnr\n",
        "from sklearn.decomposition import MiniBatchDictionaryLearning\n",
        "from sklearn.linear_model import OrthogonalMatchingPursuit\n",
        "\n",
        "# ---- Parameters ----\n",
        "scale = 3\n",
        "patch_size = 7\n",
        "stride = 3\n",
        "n_components = 512\n",
        "alpha = 1.0\n",
        "n_nonzero_coefs = 10\n",
        "\n",
        "# ---- Load image in YCbCr ----\n",
        "img_rgb = io.imread('drive/MyDrive/Colab Notebooks/butterfly_GT.bmp')\n",
        "img_ycbcr = color.rgb2ycbcr(img_rgb).astype(np.float32)\n",
        "img_y = img_ycbcr[:, :, 0] / 255.0  # Normalize Y only\n",
        "\n",
        "# Downsample and upsample Y channel\n",
        "h, w = img_y.shape\n",
        "lr = transform.resize(img_y, (h // scale, w // scale), anti_aliasing=True)\n",
        "lr_up = transform.resize(lr, (h, w), anti_aliasing=False)\n",
        "\n",
        "# ---- Patch Extraction ----\n",
        "def extract_patches(img, patch_size, stride):\n",
        "    patches, positions = [], []\n",
        "    h, w = img.shape\n",
        "    for i in range(0, h - patch_size + 1, stride):\n",
        "        for j in range(0, w - patch_size + 1, stride):\n",
        "            patches.append(img[i:i+patch_size, j:j+patch_size].flatten())\n",
        "            positions.append((i, j))\n",
        "    return np.array(patches), positions\n",
        "\n",
        "lr_patches, positions = extract_patches(lr_up, patch_size, stride)\n",
        "mean = np.mean(lr_patches, axis=1, keepdims=True)\n",
        "lr_patches -= mean\n",
        "\n",
        "# ---- Dictionary Learning (simulated) ----\n",
        "dict_learner = MiniBatchDictionaryLearning(n_components=n_components, alpha=alpha, max_iter=500)\n",
        "lr_dict = dict_learner.fit(lr_patches).components_\n",
        "hr_dict = lr_dict.copy()  # Simulate HR dict = LR dict\n",
        "\n",
        "# ---- Sparse Coding ----\n",
        "omp = OrthogonalMatchingPursuit(n_nonzero_coefs=n_nonzero_coefs)\n",
        "gammas = []\n",
        "for patch in lr_patches:\n",
        "    omp.fit(lr_dict.T, patch)\n",
        "    gammas.append(omp.coef_)\n",
        "gamma = np.array(gammas)\n",
        "hr_patches = gamma @ hr_dict\n",
        "hr_patches += mean\n",
        "\n",
        "# ---- Reconstruct HR Y-channel ----\n",
        "recon_y = np.zeros_like(img_y)\n",
        "weight = np.zeros_like(img_y)\n",
        "patch_idx = 0\n",
        "\n",
        "for (i, j) in positions:\n",
        "    patch = hr_patches[patch_idx].reshape(patch_size, patch_size)\n",
        "    recon_y[i:i+patch_size, j:j+patch_size] += patch\n",
        "    weight[i:i+patch_size, j:j+patch_size] += 1.0\n",
        "    patch_idx += 1\n",
        "\n",
        "weight[weight == 0] = 1.0\n",
        "recon_y /= weight\n",
        "recon_y = np.clip(recon_y, 0, 1)\n",
        "\n",
        "# ---- PSNR Evaluation (Y only) ----\n",
        "psnr_val = compare_psnr(img_y, recon_y)\n",
        "print(f\"\\n✅ PSNR on Y-channel: {psnr_val:.2f} dB\")\n",
        "\n",
        "# ---- Process Cb and Cr channels ----\n",
        "cb = img_ycbcr[:, :, 1]\n",
        "cr = img_ycbcr[:, :, 2]\n",
        "cb_up = transform.resize(cb, (h, w), order=3)\n",
        "cr_up = transform.resize(cr, (h, w), order=3)\n",
        "\n",
        "# ---- Merge channels back ----\n",
        "recon_ycbcr = np.stack((recon_y * 255, cb_up, cr_up), axis=2)\n",
        "recon_rgb = color.ycbcr2rgb(recon_ycbcr)\n",
        "recon_rgb = np.clip(recon_rgb, 0, 1)\n",
        "\n",
        "# ---- Display Results ----\n",
        "plt.figure(figsize=(15, 4))\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.imshow(img_rgb)\n",
        "plt.title(\"Original RGB\")\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.imshow(recon_rgb)\n",
        "plt.title(\"Reconstructed RGB (SC)\")\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.imshow(transform.resize(img_rgb, (h // scale, w // scale), anti_aliasing=True))\n",
        "plt.title(\"Low-Resolution Input\")\n",
        "plt.show()\n"
      ],
