        "import cv2\n",
        "import numpy as np\n",
        "from skimage.metrics import peak_signal_noise_ratio as compare_psnr\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- Parameters ---\n",
        "scale = 3\n",
        "border = scale  # Crop this many pixels from each side before PSNR\n",
        "\n",
        "# --- Helper: Extract Y (luminance) channel from BGR image ---\n",
        "def get_y_channel(img_bgr):\n",
        "    img_ycc = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2YCrCb)\n",
        "    return img_ycc[..., 0]\n",
        "\n",
        "# --- Helper: Crop borders before computing PSNR ---\n",
        "def shave(img, border):\n",
        "    return img[border:-border, border:-border]\n",
        "\n",
        "# --- Load HR image (color) ---\n",
        "img_hr_color = cv2.imread('drive/MyDrive/Colab Notebooks/b.png')  # Use original HR color image\n",
        "img_hr_color = cv2.resize(img_hr_color, (256, 256))  # Optional: for consistency\n",
        "\n",
        "# --- Get Y channel for PSNR ---\n",
        "img_hr_y = get_y_channel(img_hr_color)\n",
        "\n",
        "# --- Downscale to simulate LR, then upsample using bicubic ---\n",
        "h, w = img_hr_y.shape\n",
        "img_lr_y = cv2.resize(img_hr_y, (w // scale, h // scale), interpolation=cv2.INTER_CUBIC)\n",
        "img_bicubic_y = cv2.resize(img_lr_y, (w, h), interpolation=cv2.INTER_CUBIC)\n",
        "\n",
        "# --- Crop borders before PSNR (as per paper) ---\n",
        "img_hr_y_cropped = shave(img_hr_y, border)\n",
        "img_bicubic_y_cropped = shave(img_bicubic_y, border)\n",
        "\n",
        "# --- Compute PSNR ---\n",
        "psnr_bicubic = compare_psnr(img_hr_y_cropped, img_bicubic_y_cropped)\n",
        "print(f\"PSNR (Bicubic, Y channel, cropped) = {psnr_bicubic:.2f} dB\")\n",
        "\n",
        "# --- Visualization ---\n",
        "plt.figure(figsize=(12, 4))\n",
        "# --- Reconstruct full-color Bicubic image (for display only) ---\n",
        "# Resize original HR color image to LR size\n",
        "img_lr_color = cv2.resize(img_hr_color, (w // scale, h // scale), interpolation=cv2.INTER_CUBIC)\n",
        "img_bicubic_color = cv2.resize(img_lr_color, (w, h), interpolation=cv2.INTER_CUBIC)\n",
